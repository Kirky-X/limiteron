{
  "components": {
    "schemas": {
      "ApiResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Unit"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "BanResponse": {
        "properties": {
          "ban_times": {
            "type": "integer"
          },
          "expires_at": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "is_manual": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "ban_times",
          "expires_at",
          "is_manual"
        ],
        "type": "object"
      },
      "BanTarget": {
        "description": "ip/user/mac use a string value; geo uses an object with a country_code field; cidr uses a string value",
        "properties": {
          "type": {
            "enum": [
              "ip",
              "user",
              "mac",
              "geo",
              "cidr"
            ],
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "type",
          "value"
        ],
        "type": "object"
      },
      "BatchCheckBody": {
        "properties": {
          "requests": {
            "items": {
              "properties": {
                "ip": {
                  "nullable": true,
                  "type": "string"
                },
                "method": {
                  "nullable": true,
                  "type": "string"
                },
                "path": {
                  "nullable": true,
                  "type": "string"
                },
                "user_id": {
                  "nullable": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "maxItems": 1000,
            "type": "array"
          }
        },
        "required": [
          "requests"
        ],
        "type": "object"
      },
      "CircuitBreakerStatus": {
        "properties": {
          "failure_rate": {
            "format": "double",
            "type": "number"
          },
          "slow_call_rate": {
            "format": "double",
            "type": "number"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "failure_rate",
          "slow_call_rate"
        ],
        "type": "object"
      },
      "CreateBanRequest": {
        "properties": {
          "duration_secs": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "operator": {
            "description": "Deprecated: ignored by the server; identity is determined by the API key mapping",
            "nullable": true,
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/BanTarget"
          }
        },
        "required": [
          "target",
          "reason"
        ],
        "type": "object"
      },
      "FlowControlConfig": {
        "description": "Full FlowControlConfig (fields are defined in the config module; only the top-level skeleton is kept here)",
        "properties": {
          "global": {
            "type": "object"
          },
          "rules": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "global",
          "rules"
        ],
        "type": "object"
      },
      "SystemStatus": {
        "properties": {
          "active_bans": {
            "description": "Present when the ban-manager feature is enabled",
            "type": "integer"
          },
          "blocked_requests": {
            "format": "int64",
            "type": "integer"
          },
          "circuit_breaker": {
            "description": "Present when the circuit-breaker feature is enabled",
            "type": "string"
          },
          "success_rate": {
            "format": "double",
            "type": "number"
          },
          "total_requests": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "total_requests",
          "blocked_requests",
          "success_rate"
        ],
        "type": "object"
      },
      "TokenPrefetchBody": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "key": {
                  "type": "string"
                },
                "tokens": {
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "key",
                "tokens"
              ],
              "type": "object"
            },
            "maxItems": 1000,
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "UnbanRequest": {
        "properties": {
          "operator": {
            "description": "Deprecated: ignored by the server",
            "nullable": true,
            "type": "string"
          },
          "reason": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "Unit": {
        "nullable": true,
        "type": "object"
      },
      "UpdateQuotaRequest": {
        "properties": {
          "duration_secs": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "new_limit": {
            "description": "0 = reset signal",
            "format": "int64",
            "type": "integer"
          },
          "resource": {
            "type": "string"
          }
        },
        "required": [
          "resource",
          "new_limit"
        ],
        "type": "object"
      },
      "UpdateQuotaResponse": {
        "properties": {
          "expires_at": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Limiteron admin control plane: rate limit status, ban management, quota adjustment, circuit breaker status and rule hot reload. All endpoints except probes/metrics require a Bearer API key.",
    "title": "Limiteron Admin API",
    "version": "0.3.0-rc.6"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/ban": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/BanResponse"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Ban details"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Target or reason validation failed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Operator not authorized"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "ban-manager not configured"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Create ban (ip/user/mac/geo)",
      "tags": [
        "ban"
      ]
    },
    "/api/v1/ban/{target}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "target",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "enum": [
                "ip",
                "user",
                "mac",
                "geo",
                "cidr"
              ],
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnbanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Unit"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Removal result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Unsupported type"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Ban not found"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "ban-manager not configured"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Remove ban (?type=ip|user|mac|geo|cidr)",
      "tags": [
        "ban"
      ]
    },
    "/api/v1/check/batch": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchCheckBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Per-item decision results"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Empty batch or above the 1000-item limit"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Batch check (N keys decided in one request)",
      "tags": [
        "decision"
      ]
    },
    "/api/v1/config": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlowControlConfig"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Application report"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Validation failed; previous config retained"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Rule hot reload (atomic config swap; previous config retained on failure)",
      "tags": [
        "config"
      ]
    },
    "/api/v1/introspect": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Introspection snapshot JSON (structure extends with the feature combination)"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Runtime introspection snapshot (rules, decision chains, bans and circuit breakers aggregated)",
      "tags": [
        "status"
      ]
    },
    "/api/v1/quota/{user_id}": {
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateQuotaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UpdateQuotaResponse"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Operation result"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Unsupported operation"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Internal error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "quota-control not configured"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Reset a user's quota usage (new_limit=0); rejects per-tenant quota limit updates",
      "tags": [
        "quota"
      ]
    },
    "/api/v1/status": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SystemStatus"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "System status"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Authentication failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Overall system status",
      "tags": [
        "status"
      ]
    },
    "/api/v1/status/circuit-breaker": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiResponse"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/CircuitBreakerStatus"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Circuit breaker status"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "circuit-breaker not configured"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Circuit breaker status",
      "tags": [
        "status"
      ]
    },
    "/api/v1/tokens/prefetch": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenPrefetchBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Per-item granted results and summary"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Empty batch or above the 1000-item limit"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "responses": {},
      "summary": "Batch token prefetch",
      "tags": [
        "decision"
      ]
    },
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Process is alive"
          }
        }
      },
      "responses": {},
      "summary": "Liveness probe",
      "tags": [
        "probes"
      ]
    },
    "/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "text/plain; version=0.0.4 exposition"
          }
        }
      },
      "responses": {},
      "summary": "Prometheus text-format metrics",
      "tags": [
        "probes"
      ]
    },
    "/readyz": {
      "get": {
        "responses": {
          "200": {
            "description": "All components healthy"
          },
          "503": {
            "description": "One or more components unhealthy; response body contains details"
          }
        }
      },
      "responses": {},
      "summary": "Readiness probe (component-level aggregation)",
      "tags": [
        "probes"
      ]
    }
  }
}
